# Database — PostgreSQL (Neon in production, site.md §6.3).
# DATABASE_URL = pooled connection (Neon "-pooler" host) — used by the app at runtime.
#   On Vercel's serverless/PgBouncer path this MUST carry pgbouncer=true&connection_limit=1,
#   or Prisma's prepared statements collide and every request 500s:
#   ...neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT_URL   = direct connection (no "-pooler") — used by `prisma migrate` / introspection.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth — site.md §2
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of this deployment — Better Auth baseURL. No trailing slash.
# Local: http://localhost:3000   Production: https://<your-app>.vercel.app (or your custom domain)
# On Vercel this is OPTIONAL: when unset/left as localhost, lib/base-url.ts falls
# back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL. Still set it explicitly for
# a custom domain — and redeploy after changing it (NEXT_PUBLIC_* is build-time).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dev-only seed password for the 3 seeded founder accounts (prisma/seed.ts) — never used in production
SEED_FOUNDER_PASSWORD="replace-with-a-dev-only-password"

# Sentry — site.md §3
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Google Analytics 4 — site.md §4
NEXT_PUBLIC_GA_ID=""

# Cloudflare R2 — Phase 2, site.md §6.1 (unused until the storage upgrade)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Razorpay — Phase 2, site.md §6.2 (unused until the payments upgrade)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
